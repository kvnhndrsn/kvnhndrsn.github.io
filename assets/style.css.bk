

    :root {
        --accent: #2D9CDB;
        --grey: #999;
    }

    html {
        font-size:  100%;
        scroll-behavior: smooth;
    }


    body {
        margin: 0;
        font-family: Inter, sans-serif;
        background-image: url("/assets/back.png");
    }

    /* --- HEADER --- */
    .page-header {
        position: sticky;
        top: 0;
        z-index: 1000;

        width: 100%;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
    }

    /* --- NAV LAYOUT --- */
    .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        max-width: 1200px;
        margin: 0 auto;
        padding: 0.5rem 1rem;
    }

    /* LEFT / CENTER / RIGHT GROUPS */
    .nav-left,
.nav-center,
.nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
}

/* center links slightly tighter */
.nav-center {
    gap: 0.8rem;
}

/* push right section to the far edge */
.nav-right {
    gap: 0.6rem;
}

/* --- LINKS --- */
nav a {
    text-decoration: none;
    color: white;
    font-size: clamp(0.9rem, 1.2vw, 1.2rem);
}

/* --- AVATAR --- */
.avatar {
    width: 40px;
    border-radius: 50%;
}

/* --- SOCIAL ICONS --- */
.social-icon {
    width: 20px;
    opacity: 0.85;
    transition: opacity 0.2s ease;
}

.social-icon:hover {
    opacity: 1;
}

/* --- MAIN CONTENT --- */
main {
    max-width: 60ch;
    margin: 2rem auto;
    padding: 0 1rem;
}

/* --- MOBILE --- */
@media (max-width: 768px) {
    .nav {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .nav-center {
        flex-wrap: wrap;
    }

    .nav-right {
        flex-wrap: wrap;
    }
}



